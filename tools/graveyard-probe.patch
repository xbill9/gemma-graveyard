+// graveyard probe: GGML_CUDA_LOG_CUBLAS prints the first 200 matrix products that leave llama.cpp's own kernels.
+static void graveyard_log_cublas(const char * route, const ggml_tensor * src0, const ggml_tensor * src1) {
+    static const bool on = getenv("GGML_CUDA_LOG_CUBLAS") != nullptr;
+    static int n = 0;
+    if (on && n < 200) {
+        n++;
+        fprintf(stderr, "graveyard %s: %s %s [%lld x %lld] x src1 %s cols %lld\n", route, src0->name, ggml_type_name(src0->type),
+            (long long) src0->ne[0], (long long) src0->ne[1], ggml_type_name(src1->type), (long long) src1->ne[1]);
+    }
+}
