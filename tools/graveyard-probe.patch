         return;
     }
+    // graveyard probe: GGML_CUDA_SPLIT_TO_VEC sends a matrix that would go to cuBLAS through the one-column
+    // vector kernel instead, one column of src1 at a time (the route a single generated token takes).
+    static const bool split_to_vec = getenv("GGML_CUDA_SPLIT_TO_VEC") != nullptr;
+    if (split_to_vec && !ggml_is_quantized(src0->type) && ne02 == 1 && ne03 == 1 && ne12 == 1 && ne13 == 1
+            && ggml_is_contiguous(src1) && ggml_is_contiguous(dst)
+            && ggml_cuda_should_use_mmvf(src0->type, cc, warp_size, src0->ne, src0->nb, 1)) {
+        graveyard_log_cublas("split_to_vec", src0, src1);
+        for (int64_t j = 0; j < ne11; ++j) {
+            ggml_tensor s1 = *src1;
+            s1.ne[1] = 1; s1.nb[2] = s1.nb[1]; s1.nb[3] = s1.nb[1];
+            s1.data = (char *) src1->data + j*src1->nb[1];
+            ggml_tensor d = *dst;
+            d.ne[1] = 1; d.nb[2] = d.nb[1]; d.nb[3] = d.nb[1];
+            d.data = (char *) dst->data + j*dst->nb[1];
+            ggml_cuda_mul_mat_vec_f(ctx, src0, &s1, nullptr, &d);
+        }
+        return;
+    }
+    graveyard_log_cublas("cublas_fallback", src0, src1);
     ggml_cuda_mul_mat_cublas(ctx, src0, src1, dst);
